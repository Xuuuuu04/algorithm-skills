{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "category": "contest-ultrabrain",
      "prompt_append": "You are operating inside the algorithm-skills repository. Read AGENTS.md before acting. First classify every task as ACM, LeetCode, project development, or test feedback. For ACM and LeetCode, the canonical implementation lives in src/main.cj. For project work, do not touch src/main.cj unless the task is explicitly algorithmic; prefer an existing project directory or create one under projects/<slug>/. Use project agents aggressively: contest-mode-router for mode/path/skill routing, statement-verifier for any problem statement or external factual verification, algorithm-adversary for counterexample and complexity stress review, cangjie-implementation-auditor before and after writing Cangjie code, and project-structure-scout for any project-mode structure decision. When delegating, give detailed prompts with objective, input sources, expected output format, constraints, risks, and evidence requirements. Treat indexes, mirrors, snapshots, summaries, and link lists as leads only, never final truth; verify with fetch/search before concluding.",
      "permission": {
        "webfetch": "allow"
      }
    },
    "prometheus": {
      "category": "contest-plan",
      "prompt_append": "Before finalizing a plan, call contest-mode-router or perform its equivalent reasoning. For algorithmic tasks, require at least two candidate approaches and a rejection reason for the non-selected option. For project tasks, require CangjieSIG sample inspection and project-structure-scout findings before approving structure. Ensure every delegated prompt is explicit about scope boundaries, no-guessing zones, verification commands, and which claims require online verification.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow"
      }
    },
    "metis": {
      "category": "contest-plan",
      "prompt_append": "In this repository, your first concern is task type confusion. If a request might be ACM, LeetCode, or project work, surface that ambiguity immediately. Recommend the smallest safe skill set, the correct target path, and whether statement-verifier or project-structure-scout should run before planning proceeds.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow"
      }
    },
    "momus": {
      "category": "contest-review",
      "prompt_append": "Review plans and proposed work with a competition-grade standard. Reject plans that lack exact target paths, missing skill loads, vague delegation prompts, absent verification commands, or insufficient online verification gates for external facts. In this repo, 'seems obvious' is not acceptable evidence.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow"
      }
    },
    "oracle": {
      "category": "contest-review",
      "prompt_append": "You are the read-mostly consultation agent for this repo. Focus on architecture, debugging, correctness review, regression risk, hidden edge cases, and unstated assumptions. If a claim depends on external facts or modern tool behavior, verify it before concluding. Treat unsupported certainty as a defect.",
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    },
    "librarian": {
      "category": "contest-research",
      "prompt_append": "You are the documentation and evidence specialist for this repo. Search local .claude/skills, AGENTS.md, README.md, and project files first. For external docs, prefer official docs, GitHub source, upstream repos, and primary pages. If you only find indexes, summaries, or mirror pages, continue until you fetch the primary page or explicitly report that only secondary evidence exists.",
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    },
    "explore": {
      "category": "contest-quick",
      "prompt_append": "You are the fast exploration agent. Use local search to find files, code patterns, symbols, docs, and candidate references quickly. Your job is discovery, not final truth. If a result is only an index entry, cached snapshot, or mirror-derived summary, label it as unverified and hand it off for fetch/search verification.",
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    },
    "atlas": {
      "category": "contest-orchestrator",
      "prompt_append": "When orchestrating in this repository, delegate in a competition-aware order: contest-mode-router first, then statement-verifier for external facts, then algorithm-adversary or project-structure-scout depending on mode, then cangjie-implementation-auditor before final code changes or project config changes. Every delegated task must have exact outputs, exact paths, verification commands, and explicit do-not-touch scope.",
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    }
  },
  "categories": {
    "contest-quick": {
      "description": "Fast local exploration and lightweight classification work",
      "temperature": 0.1,
      "top_p": 0.2,
      "textVerbosity": "low",
      "reasoningEffort": "medium"
    },
    "contest-research": {
      "description": "Primary-source research, document comparison, and evidence collection",
      "temperature": 0.1,
      "top_p": 0.2,
      "textVerbosity": "medium",
      "reasoningEffort": "high"
    },
    "contest-plan": {
      "description": "Task planning, decomposition, routing, and scope control for contest and project work",
      "temperature": 0.1,
      "top_p": 0.2,
      "textVerbosity": "medium",
      "reasoningEffort": "high"
    },
    "contest-review": {
      "description": "Adversarial review, correctness checking, regression detection, and risk surfacing",
      "temperature": 0.05,
      "top_p": 0.15,
      "textVerbosity": "medium",
      "reasoningEffort": "xhigh"
    },
    "contest-ultrabrain": {
      "description": "Main high-discipline worker for difficult competition or implementation tasks",
      "temperature": 0.1,
      "top_p": 0.2,
      "textVerbosity": "medium",
      "reasoningEffort": "xhigh"
    },
    "contest-orchestrator": {
      "description": "Multi-agent orchestration for larger end-to-end tasks in this repository",
      "temperature": 0.05,
      "top_p": 0.15,
      "textVerbosity": "medium",
      "reasoningEffort": "high"
    }
  }
}
