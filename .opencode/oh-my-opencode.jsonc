{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "category": "contest-ultrabrain",
      "skills": [
        "contest-mode-discipline",
        "contest-delegation-discipline",
        "contest-fact-verification",
        "contest-final-quality-bar",
        "contest-acm-delegation-template",
        "contest-leetcode-delegation-template",
        "contest-project-delegation-template",
        "contest-feedback-repair-discipline",
        "contest-adversarial-discipline"
      ],
      "prompt_append": "You are operating inside the algorithm-skills repository. Read AGENTS.md before acting. First classify every task as ACM, LeetCode, project development, or test feedback. For ACM and LeetCode, the canonical implementation lives in src/main.cj. For project work, do not touch src/main.cj unless the task is explicitly algorithmic; prefer an existing project directory or create one under projects/<slug>/. Use project agents aggressively: contest-mode-router for mode/path/skill routing, statement-verifier for any problem statement or external factual verification, algorithm-adversary for counterexample and complexity stress review, cangjie-implementation-auditor before and after writing Cangjie code, and project-structure-scout for any project-mode structure decision. When delegating, give detailed prompts with objective, input sources, expected output format, constraints, risks, and evidence requirements. Treat indexes, mirrors, snapshots, summaries, and link lists as leads only, never final truth; verify with fetch/search before concluding. For external problems such as Codeforces, LeetCode, AtCoder, HDU, Luogu, or repository-linked tasks, prefer direct online fetch/search of the primary source when networking is available; local datasets in this repo are accelerators, not the final authority.",
      "permission": {
        "webfetch": "allow"
      }
    },
    "prometheus": {
      "category": "contest-plan",
      "skills": [
        "contest-mode-discipline",
        "contest-delegation-discipline",
        "contest-final-quality-bar",
        "contest-acm-delegation-template",
        "contest-leetcode-delegation-template",
        "contest-project-delegation-template",
        "contest-feedback-repair-discipline"
      ],
      "prompt_append": "Before finalizing a plan, call contest-mode-router or perform its equivalent reasoning. For algorithmic tasks, require at least two candidate approaches and a rejection reason for the non-selected option. For project tasks, require CangjieSIG sample inspection and project-structure-scout findings before approving structure. Ensure every delegated prompt is explicit about scope boundaries, no-guessing zones, verification commands, and which claims require online verification.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow"
      }
    },
    "metis": {
      "category": "contest-plan",
      "skills": [
        "contest-mode-discipline",
        "contest-delegation-discipline",
        "contest-feedback-repair-discipline"
      ],
      "prompt_append": "In this repository, your first concern is task type confusion. If a request might be ACM, LeetCode, or project work, surface that ambiguity immediately. Recommend the smallest safe skill set, the correct target path, and whether statement-verifier or project-structure-scout should run before planning proceeds.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow"
      }
    },
    "momus": {
      "category": "contest-review",
      "skills": [
        "contest-delegation-discipline",
        "contest-final-quality-bar",
        "contest-fact-verification",
        "contest-feedback-repair-discipline",
        "contest-adversarial-discipline"
      ],
      "prompt_append": "Review plans and proposed work with a competition-grade standard. Reject plans that lack exact target paths, missing skill loads, vague delegation prompts, absent verification commands, or insufficient online verification gates for external facts. In this repo, 'seems obvious' is not acceptable evidence.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "webfetch": "allow"
      }
    },
    "oracle": {
      "category": "contest-review",
      "skills": [
        "contest-fact-verification",
        "contest-final-quality-bar",
        "contest-feedback-repair-discipline",
        "contest-adversarial-discipline"
      ],
      "prompt_append": "You are the read-mostly consultation agent for this repo. Focus on architecture, debugging, correctness review, regression risk, hidden edge cases, and unstated assumptions. If a claim depends on external facts or modern tool behavior, verify it before concluding. Treat unsupported certainty as a defect.",
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    },
    "librarian": {
      "category": "contest-research",
      "skills": [
        "contest-fact-verification"
      ],
      "prompt_append": "You are the documentation and evidence specialist for this repo. Search local .claude/skills, AGENTS.md, README.md, and project files first. For external docs, prefer official docs, GitHub source, upstream repos, and primary pages. If you only find indexes, summaries, or mirror pages, continue until you fetch the primary page or explicitly report that only secondary evidence exists. For external programming problems, do not stop at local indexes or mirrored summaries if the network is available; search for the primary page and fetch it.",
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    },
    "explore": {
      "category": "contest-quick",
      "skills": [
        "contest-mode-discipline"
      ],
      "prompt_append": "You are the fast exploration agent. Use local search to find files, code patterns, symbols, docs, and candidate references quickly. Your job is discovery, not final truth. If a result is only an index entry, cached snapshot, or mirror-derived summary, label it as unverified and hand it off for fetch/search verification. If you discover that a task refers to an external problem, hand off with a recommendation to search/fetch the primary source rather than treating local dataset entries as authoritative.",
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    },
    "atlas": {
      "category": "contest-orchestrator",
      "skills": [
        "contest-delegation-discipline",
        "contest-final-quality-bar",
        "contest-fact-verification",
        "contest-mode-discipline",
        "contest-acm-delegation-template",
        "contest-leetcode-delegation-template",
        "contest-project-delegation-template",
        "contest-feedback-repair-discipline",
        "contest-adversarial-discipline"
      ],
      "prompt_append": "When orchestrating in this repository, delegate in a competition-aware order: contest-mode-router first, then statement-verifier for external facts, then algorithm-adversary or project-structure-scout depending on mode, then cangjie-implementation-auditor before final code changes or project config changes. Every delegated task must have exact outputs, exact paths, verification commands, and explicit do-not-touch scope.",
      "permission": {
        "edit": "deny",
        "webfetch": "allow"
      }
    }
  },
  "categories": {
    "contest-quick": {
      "description": "Fast local exploration and lightweight classification work",
      "temperature": 0.1,
      "top_p": 0.2,
      "textVerbosity": "low",
      "reasoningEffort": "medium"
    },
    "contest-research": {
      "description": "Primary-source research, document comparison, and evidence collection",
      "temperature": 0.1,
      "top_p": 0.2,
      "textVerbosity": "medium",
      "reasoningEffort": "high"
    },
    "contest-plan": {
      "description": "Task planning, decomposition, routing, and scope control for contest and project work",
      "temperature": 0.1,
      "top_p": 0.2,
      "textVerbosity": "medium",
      "reasoningEffort": "high"
    },
    "contest-review": {
      "description": "Adversarial review, correctness checking, regression detection, and risk surfacing",
      "temperature": 0.05,
      "top_p": 0.15,
      "textVerbosity": "medium",
      "reasoningEffort": "xhigh"
    },
    "contest-ultrabrain": {
      "description": "Main high-discipline worker for difficult competition or implementation tasks",
      "temperature": 0.1,
      "top_p": 0.2,
      "textVerbosity": "medium",
      "reasoningEffort": "xhigh"
    },
    "contest-orchestrator": {
      "description": "Multi-agent orchestration for larger end-to-end tasks in this repository",
      "temperature": 0.05,
      "top_p": 0.15,
      "textVerbosity": "medium",
      "reasoningEffort": "high"
    }
  },
  "skills": {
    "contest-mode-discipline": {
      "description": "Always classify work as ACM, LeetCode, project development, or test feedback before planning or coding.",
      "instructions": "Before doing substantial work, determine the mode: ACM, LeetCode, project development, or test feedback. Map the task to the correct path: src/main.cj for ACM/LeetCode, existing project directory or projects/<slug>/ for project work. Never let project work silently drift into src/main.cj. If mode is ambiguous, surface the ambiguity early instead of guessing."
    },
    "contest-delegation-discipline": {
      "description": "Write explicit, verification-oriented delegate prompts for subagents.",
      "instructions": "When delegating, provide a detailed prompt with objective, input sources, expected outputs, scope boundaries, must-do items, must-not-do items, required evidence, and exact verification steps. Avoid vague prompts. If external facts are involved, explicitly require fetch/search verification in the delegated task."
    },
    "contest-fact-verification": {
      "description": "Treat indexes, mirrors, snapshots, and summaries as leads only; verify with primary sources before concluding.",
      "instructions": "If a conclusion depends on a link index, cached snapshot, mirror, repository summary, version summary, or any potentially stale source, do not present it as final truth until it has been checked with fetch/search against primary or official sources where possible. If only secondary evidence exists, say so explicitly. If networking is available and the task concerns an external problem or upstream project, prefer direct fetch/search of the primary source before relying on local snapshots."
    },
    "contest-final-quality-bar": {
      "description": "Require high-confidence delivery gates before declaring work complete.",
      "instructions": "Before concluding that a task is done, verify that the mode and target path were correct, local validation actually ran where possible, external facts were verified, major risks were surfaced, and no avoidable out-of-scope edits were introduced. If any of these checks fail, do not claim completion."
    },
    "contest-acm-delegation-template": {
      "description": "ACM 模式下的委派模板纪律。",
      "instructions": "For ACM work, delegated prompts must explicitly include: full task type, input/output interpretation, complexity target, candidate algorithms, adversarial edge cases, exact target path src/main.cj, local verification commands, and any required external statement verification. Require a clear distinction between verified statement facts and inferred assumptions. When the source problem is external, the delegated task should explicitly require fetching the original statement page when possible."
    },
    "contest-leetcode-delegation-template": {
      "description": "LeetCode 模式下的委派模板纪律。",
      "instructions": "For LeetCode work, delegated prompts must explicitly include the platform-style abstraction, the equivalent local Cangjie target in src/main.cj, return-value expectations, class/function mapping, edge-case families, complexity target, and how the local implementation maps back to the platform submission shape. When the source problem is external, the delegated task should explicitly require fetching the original problem page or official description when possible."
    },
    "contest-project-delegation-template": {
      "description": "项目模式下的委派模板纪律。",
      "instructions": "For project work, delegated prompts must explicitly include project type, target directory, whether this is new project creation or modification, structure constraints, CangjieSIG sample references to inspect, cjpm/build/test verification steps, and explicit out-of-scope boundaries. Never allow project work to silently drift into src/main.cj."
    },
    "contest-feedback-repair-discipline": {
      "description": "评测与报错反馈后的修复纪律。",
      "instructions": "When the user reports WA, TLE, RE, MLE, CE, runtime errors, or failing project tests, do not jump straight to edits. First classify the mode, classify the failure type, determine the most likely root-cause family, choose the minimal relevant skills, reproduce or restate the failing condition, and only then propose or perform a fix."
    },
    "contest-adversarial-discipline": {
      "description": "高难题和高风险实现必须先经过对抗审查。",
      "instructions": "Before finalizing a hard algorithmic solution, require at least one adversarial review pass that challenges correctness, complexity, edge cases, degeneracy, overflow, and hidden assumptions. Do not accept unproven greedy logic or suspicious complexity claims as-is."
    }
  }
}
